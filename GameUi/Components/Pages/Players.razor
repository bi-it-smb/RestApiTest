@page "/"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using GameUi.Models

@inject IHttpClientFactory ClientFactory

<h1 class="text-center mb-4">Game Dashboard</h1>

@if (players == null)
{
    <p>Lade Spieler...</p>
}
else
{
    <div class="row">

        @foreach (var player in players)
        {
            <div class="col-md-4 mb-4">

                <div class="card shadow border-primary">

                    <div class="card-body bg-light">

                        <h3>@player.Name</h3>

                        <p>
                            Class:
                            <strong>@player.Class</strong>
                        </p>

                        <hr />

                        <h5>Level @player.Level</h5>

                        <p class="mt-3 mb-1">HP</p>

                        <div class="progress mb-3">
                            <div class="progress-bar bg-danger"
                                 role="progressbar"
                                 style="width:@(player.Health)%">
                                @player.Health HP
                            </div>
                        </div>

                        <p class="mb-1">XP</p>

                        <div class="progress mb-3">
                            <div class="progress-bar bg-success"
                                 role="progressbar"
                                 style="width:@(player.Experience)%">
                                @player.Experience / 100 XP
                            </div>
                        </div>

                        <h5>Gold: @player.Gold</h5>

                        <hr />

                        <button class="btn btn-danger me-2"
                                @onclick="() => Fight(player.Id)">
                            ⚔
                        </button>

                        <button class="btn btn-primary"
                                @onclick="() => Heal(player.Id)">
                            ❤️
                        </button>

                    </div>

                </div>

            </div>
        }

        <hr />

        <h2>Battle Log</h2>

        @if (battleLog.Count == 0)
        {
            <p>No battles yet...</p>
        }
        else
        {
            <div class="card shadow">
                <div class="card-body">

                    @foreach (var entry in battleLog)
                    {
                        <p class="mb-2">
                            @entry
                        </p>
                    }

                </div>
            </div>
        }

    </div>
}

@code {

    private List<Player>? players;

    private List<string> battleLog = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadPlayers();
    }


    private async Task LoadPlayers()
    {
        var client = ClientFactory.CreateClient("RestApiTest");

        players = await client.GetFromJsonAsync<List<Player>>("players");
    }

    private async Task Fight(int id)
    {
        var client = ClientFactory.CreateClient("RestApiTest");

        var response = await client.PostAsync($"players/{id}/fight", null);

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<BattleResult>();

            if (result != null)
            {
                battleLog.Insert(0,
                    $"⚔ {result.Message} | " +
                    $"-{result.DamageTaken} HP | " +
                    $"+{result.ExperienceGained} XP | " +
                    $"+{result.GoldGained} Gold");
            }
        }

        await LoadPlayers();
    }


    private async Task Heal(int id)
    {
        var client = ClientFactory.CreateClient("RestApiTest");

        await client.PostAsync($"players/{id}/heal", null);

        await LoadPlayers();
    }

}